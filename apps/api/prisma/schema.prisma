generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Coin {
  ARS
  USD
  EUR
  BOB
}

enum PaymentState {
  PENDIENTE
  PAGADO
  VENCIDO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  QR
}

enum BillingPeriod {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  UNICO
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique @db.Citext
  address   String
  cellphone String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
}

model Client {
  id        String   @id @default(uuid())
  companyId String
  fullname  String   @db.Citext
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offeredServices OfferedService[]

  @@unique([companyId, fullname])
  @@index([companyId])
}

model OfferedService {
  id            String        @id @default(uuid())
  clientId      String
  description   String        @db.Citext
  price         Decimal       @db.Decimal(12, 2)
  coin          Coin
  billingPeriod BillingPeriod
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([clientId, description])
  @@index([clientId])
}

model Payment {
  id               String        @id @default(uuid())
  offeredServiceId String
  amount           Decimal       @db.Decimal(12, 2)
  startDate        DateTime
  endDate          DateTime
  paymentState     PaymentState  @default(PAGADO)
  paymentMethod    PaymentMethod
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  offeredService OfferedService @relation(fields: [offeredServiceId], references: [id], onDelete: Restrict)

  @@unique([offeredServiceId, startDate, endDate])
  @@index([offeredServiceId])
}
